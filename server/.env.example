# Server Port (Vercel uses environment variable PORT automatically)
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb://localhost:27017/corporate-travel-expense

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL for CORS (production: your Vercel frontend URL)
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration (for receipt uploads)
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
